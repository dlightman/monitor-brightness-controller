<UserControl x:Class="MonitorBrightnessController.Presentation.MonitorControlGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="520">
    <Border BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="4"
            Padding="12" Margin="0,0,0,8">
        <Grid IsEnabled="{Binding IsControllable}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Label: monitor index + name (Requirement 2.1) -->
            <TextBlock Grid.Row="0"
                       Text="{Binding Label}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />

            <!-- Slider (0-100 integer increments) + numeric text input (Requirements 2.2, 2.3) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Slider x:Name="BrightnessSlider"
                        Grid.Column="0"
                        Minimum="0"
                        Maximum="100"
                        SmallChange="1"
                        LargeChange="10"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        VerticalAlignment="Center"
                        Value="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Thumb.DragCompleted="BrightnessSlider_DragCompleted"
                        ValueChanged="BrightnessSlider_ValueChanged" />

                <TextBox x:Name="BrightnessInput"
                         Grid.Column="1"
                         Width="56"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         TextAlignment="Right"
                         MaxLength="3"
                         Text="{Binding BrightnessText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         KeyDown="BrightnessInput_KeyDown"
                         LostFocus="BrightnessInput_LostFocus" />
            </Grid>

            <!-- Validation error message (Requirement 2.7) -->
            <TextBlock Grid.Row="2"
                       Text="{Binding ValidationError}"
                       Foreground="#FFCC0000"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- DDC/CI failure message (Requirement 2.8) -->
            <TextBlock Grid.Row="3"
                       Text="{Binding ErrorMessage}"
                       Foreground="#FFCC0000"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
    </Border>
</UserControl>
