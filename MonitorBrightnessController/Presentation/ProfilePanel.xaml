<UserControl x:Class="MonitorBrightnessController.Presentation.ProfilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="520">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Saved Profiles"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />

        <!-- Existing profiles list -->
        <ListBox Grid.Row="1"
                 MinHeight="100"
                 MaxHeight="200"
                 ItemsSource="{Binding ProfileNames}"
                 SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}" />

        <!-- Action buttons for selected profile: Apply, Edit (update), Delete, Create Shortcut -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Apply"
                    Padding="12,4"
                    IsEnabled="{Binding CanDelete}"
                    Click="ApplyButton_Click"
                    ToolTip="Apply the selected profile to all monitors" />
            <Button Content="Update"
                    Margin="8,0,0,0"
                    Padding="12,4"
                    IsEnabled="{Binding CanDelete}"
                    Click="EditButton_Click"
                    ToolTip="Save current brightness levels into the selected profile" />
            <Button Content="Delete"
                    Margin="8,0,0,0"
                    Padding="12,4"
                    IsEnabled="{Binding CanDelete}"
                    Click="DeleteButton_Click" />
            <Button Content="Create Shortcut..."
                    Margin="8,0,0,0"
                    Padding="12,4"
                    IsEnabled="{Binding CanDelete}"
                    Click="CreateShortcutButton_Click"
                    ToolTip="Create a Windows shortcut to apply the selected profile" />
        </StackPanel>

        <!-- New profile name input + Create button -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="NewProfileNameInput"
                     Grid.Column="0"
                     VerticalAlignment="Center"
                     MaxLength="64"
                     Text="{Binding NewProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="1"
                    Content="Create New"
                    Margin="8,0,0,0"
                    Padding="12,4"
                    Click="CreateButton_Click"
                    ToolTip="Save current brightness levels as a new profile" />
        </Grid>

        <!-- Inline validation / error -->
        <TextBlock Grid.Row="4"
                   Text="{Binding ValidationError}"
                   Foreground="#FFCC0000"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- Status / confirmation message -->
        <TextBlock Grid.Row="5"
                   Text="{Binding StatusMessage}"
                   Foreground="#FF2E7D32"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</UserControl>
