<Window x:Class="MonitorBrightnessController.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:MonitorBrightnessController.Presentation"
        mc:Ignorable="d"
        Title="Monitor Brightness Controller" Height="540" Width="580"
        MinWidth="440" MinHeight="320"
        Icon="/Assets/app.ico">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Startup notice, e.g. last profile not found -->
        <Border Grid.Row="0"
                Margin="0,0,0,8"
                Padding="10,8"
                Background="#FFFFF4CE"
                BorderBrush="#FFE6C200"
                BorderThickness="1"
                CornerRadius="3"
                Visibility="{Binding HasStartupNotice, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding StartupNotice}"
                       TextWrapping="Wrap"
                       Foreground="#FF665C00" />
        </Border>

        <!-- Tabbed content: Monitors, Profiles, Settings, Help -->
        <TabControl Grid.Row="1">
            <!-- Tab 1: Monitor brightness controls -->
            <TabItem Header="Monitors">
                <Grid Margin="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasNoControllableMonitors, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Monitors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <p:MonitorControlGroup />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="{Binding NoMonitorsMessage}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#FF666666"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Visibility="{Binding HasNoControllableMonitors, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </TabItem>

            <!-- Tab 2: Profiles -->
            <TabItem Header="Profiles">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ContentControl x:Name="ProfilePanelHost" Grid.Row="0" />

                        <TextBlock Grid.Row="1"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#FF666666"
                                   FontSize="11.5"
                                   Text="Profiles save the current brightness of all connected monitors. Use Apply to restore a profile, or create a Windows shortcut for quick access." />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Settings -->
            <TabItem Header="Settings">
                <StackPanel Margin="12">
                    <TextBlock Text="Application Settings"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,12" />

                    <CheckBox Content="Apply last-used profile on startup"
                              IsChecked="{Binding AutoApplyOnStartup, Mode=TwoWay}"
                              Margin="0,0,0,8" />

                    <CheckBox Content="Minimize to system tray (instead of taskbar)"
                              IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                              Margin="0,0,0,8" />

                    <CheckBox Content="Smooth brightness transitions"
                              IsChecked="{Binding SmoothTransition, Mode=TwoWay}"
                              Margin="0,0,0,4" />

                    <!-- Sub-panel for transition duration, visible when smooth transition is enabled -->
                    <StackPanel Orientation="Horizontal"
                                Margin="24,0,0,8"
                                Visibility="{Binding SmoothTransition, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Duration:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <Slider Minimum="100"
                                Maximum="2000"
                                TickFrequency="100"
                                IsSnapToTickEnabled="True"
                                Width="180"
                                VerticalAlignment="Center"
                                Value="{Binding TransitionDurationMs, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center"
                                   Margin="8,0,0,0">
                            <TextBlock.Text>
                                <Binding Path="TransitionDurationMs" StringFormat="{}{0} ms" />
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <CheckBox Content="Start with Windows"
                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                              Margin="0,0,0,8" />

                    <CheckBox Content="Refresh brightness on window focus"
                              IsChecked="{Binding RefreshOnFocus, Mode=TwoWay}"
                              Margin="0,0,0,8" />

                    <TextBlock Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               Foreground="#FF666666"
                               FontSize="11.5"
                               Text="Settings are saved automatically to %LOCALAPPDATA%\MonitorBrightnessController\settings.json" />
                </StackPanel>
            </TabItem>

            <!-- Tab 4: Help -->
            <TabItem Header="Help">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="HelpContent"
                               TextWrapping="Wrap"
                               FontFamily="Segoe UI"
                               FontSize="12.5"
                               LineHeight="20" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
