<Window x:Class="MonitorBrightnessController.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:MonitorBrightnessController.Presentation"
        mc:Ignorable="d"
        Title="Monitor Brightness Controller" Height="540" Width="580"
        MinWidth="440" MinHeight="320"
        Icon="/Assets/app.ico">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Startup notice, e.g. last profile not found -->
        <Border Grid.Row="0"
                Margin="0,0,0,8"
                Padding="10,8"
                Background="#FFFFF4CE"
                BorderBrush="#FFE6C200"
                BorderThickness="1"
                CornerRadius="3"
                Visibility="{Binding HasStartupNotice, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding StartupNotice}"
                       TextWrapping="Wrap"
                       Foreground="#FF665C00" />
        </Border>

        <!-- Tabbed content: Monitors, Settings, About -->
        <TabControl Grid.Row="1" SelectedIndex="0">
            <!-- Tab 1: Monitor brightness controls -->
            <TabItem Header="Monitors">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasNoControllableMonitors, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Monitors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <p:MonitorControlGroup />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="{Binding NoMonitorsMessage}"
                               Grid.Row="0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#FF666666"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Visibility="{Binding HasNoControllableMonitors, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- Profile Strip below monitor controls (Requirement 3.1) -->
                    <p:ProfileStrip x:Name="ProfileStripControl" Grid.Row="1" Margin="0,12,0,0" />
                </Grid>
            </TabItem>

            <!-- Tab 2: Settings -->
            <TabItem Header="Settings">
                <StackPanel Margin="12">
                    <TextBlock Text="Application Settings"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,12" />

                    <!-- Startup Profile section (Req 6.1, 6.2, 6.3, 6.4, 6.5) -->
                    <TextBlock Text="Startup Profile"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,0,0,6" />

                    <CheckBox Content="Auto apply profile on start"
                              IsChecked="{Binding AutoApplyOnStartup, Mode=TwoWay}"
                              Margin="0,0,0,6" />

                    <StackPanel Orientation="Horizontal" Margin="24,0,0,12">
                        <TextBlock Text="Startup profile:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox x:Name="Startup_Profile_Dropdown"
                                  ItemsSource="{Binding StartupProfileOptions}"
                                  SelectedItem="{Binding SelectedStartupProfileName, Mode=TwoWay}"
                                  IsEnabled="{Binding AutoApplyOnStartup}"
                                  Width="180"
                                  VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="Last Used">
                                                        <Setter Property="FontStyle" Value="Italic" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <CheckBox Content="Minimize to system tray (instead of taskbar)"
                              IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                              Margin="0,0,0,8" />

                    <CheckBox Content="Smooth brightness transitions"
                              IsChecked="{Binding SmoothTransition, Mode=TwoWay}"
                              Margin="0,0,0,4" />

                    <!-- Sub-panel for transition duration, visible when smooth transition is enabled -->
                    <StackPanel Orientation="Horizontal"
                                Margin="24,0,0,8"
                                Visibility="{Binding SmoothTransition, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Duration:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <Slider Minimum="100"
                                Maximum="2000"
                                TickFrequency="100"
                                IsSnapToTickEnabled="True"
                                Width="180"
                                VerticalAlignment="Center"
                                Value="{Binding TransitionDurationMs, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center"
                                   Margin="8,0,0,0">
                            <TextBlock.Text>
                                <Binding Path="TransitionDurationMs" StringFormat="{}{0} ms" />
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <CheckBox Content="Start with Windows"
                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                              Margin="0,0,0,8" />

                    <CheckBox Content="Refresh brightness on window focus"
                              IsChecked="{Binding RefreshOnFocus, Mode=TwoWay}"
                              Margin="0,0,0,8" />

                    <TextBlock Text="{Binding StartupProfileError}"
                               Foreground="Red"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="{Binding HasStartupProfileError, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- Create Shortcut section (Req 5.1, 5.2, 5.5, 5.6) -->
                    <TextBlock Text="Create Shortcut"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,12,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Profile:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding ShortcutProfileOptions}"
                                  SelectedItem="{Binding SelectedShortcutProfile, Mode=TwoWay}"
                                  Width="180"
                                  VerticalAlignment="Center">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Style.Triggers>
                                        <Trigger Property="SelectedItem" Value="{x:Null}">
                                            <Setter Property="Tag" Value="Select profile" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </StackPanel>

                    <Button Content="Create Shortcut"
                            Command="{Binding CreateShortcutCommand}"
                            IsEnabled="{Binding CanCreateShortcut}"
                            HorizontalAlignment="Left"
                            Padding="12,4"
                            Margin="0,0,0,8" />

                    <TextBlock Text="{Binding ShortcutStatusMessage}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="{Binding HasShortcutStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- Proper Install section (Req 4.1, 4.8, 4.9, 4.10) -->
                    <StackPanel Margin="0,8,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Proper Install"
                                    Command="{Binding ProperInstallCommand}"
                                    Padding="12,4"
                                    Margin="0,0,12,0" />
                            <TextBlock Text="{Binding InstallStatusText}"
                                       VerticalAlignment="Center"
                                       Foreground="#FF228B22"
                                       Visibility="{Binding IsProperlyInstalled, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding InstallResultMessage}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding HasInstallResultMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                    <TextBlock Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               Foreground="#FF666666"
                               FontSize="11.5"
                               Text="Settings are saved automatically to %LOCALAPPDATA%\MonitorBrightnessController\settings.json" />
                </StackPanel>
            </TabItem>

            <!-- Tab 3: About (Req 7.1, 7.2, 7.3, 7.4, 7.6) -->
            <TabItem Header="About">
                <StackPanel Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Monitor Brightness Controller"
                               FontWeight="Bold"
                               FontSize="18"
                               Margin="0,0,0,16"
                               HorizontalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="Version: " FontSize="13" />
                        <TextBlock Text="{Binding AppVersion}" FontSize="13" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="Built: " FontSize="13" />
                        <TextBlock Text="{Binding BuildDate}" FontSize="13" />
                    </StackPanel>

                    <TextBlock HorizontalAlignment="Center" FontSize="13">
                        <Hyperlink NavigateUri="https://github.com/dlightman/monitor-brightness-controller"
                                   RequestNavigate="Hyperlink_RequestNavigate">
                            GitHub Repository
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
